{
  "name": "accommo-web",
  "version": "0.0.1",
  "description": "Boarding-house listings for ISU Echague students",
  "productName": "Accommo",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node node_modules/@quasar/app-vite/bin/quasar.js dev",
    "build": "node node_modules/@quasar/app-vite/bin/quasar.js build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .js,.ts,.vue",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@quasar/extras": "^2.0.0",
    "@supabase/supabase-js": "^2.111.0",
    "apexcharts": "^6.7.1",
    "dotenv": "^17.4.2",
    "mapbox-gl": "^3.28.1",
    "pinia": "^4.0.2",
    "quasar": "^2.23.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.132",
    "@quasar/app-vite": "^3.2.0",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 18"
  }
}
